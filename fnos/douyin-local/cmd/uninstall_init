#!/bin/bash
# 卸载前执行。
#
# 视频原片是用户自己的文件，本脚本绝不碰。
#
# 注意：飞牛的卸载对话框里通常有「清除本地数据」选项，勾选后系统会一并
# 清空 /vol{n}/@appdata/<appname>（就是下面的 TRIM_PKGVAR），里面有数据库、
# 收藏、观看历史、封面与换封装缓存。所以这里只如实告知位置和风险，不替用户
# 做决定，也不假装数据一定安全。

VAR_DIR="${TRIM_PKGVAR:-/var/apps/douyin-local/var}"
VIDEO_DIR="${wizard_video_dir:-/vol1/1000/videos}"
LOG="${TRIM_TEMP_LOGFILE:-/dev/stdout}"

echo "即将卸载 douyin-local。" >> "$LOG"
echo "" >> "$LOG"
echo "视频原片不会被删除：" >> "$LOG"
echo "  $VIDEO_DIR" >> "$LOG"
echo "" >> "$LOG"
echo "收藏、观看历史、数据库与封面缓存存放在：" >> "$LOG"
echo "  $VAR_DIR" >> "$LOG"
echo "如果卸载时勾选了「清除本地数据」，上面的目录会被系统一并删掉。" >> "$LOG"
echo "想留着就先备份（在飞牛终端里执行）：" >> "$LOG"
echo "  cp -a \"$VAR_DIR\" /vol1/1000/douyin-local-backup" >> "$LOG"

exit 0
