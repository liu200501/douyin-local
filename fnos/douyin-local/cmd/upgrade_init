#!/bin/bash
# 升级前执行。数据都在 TRIM_PKGVAR 与视频目录里，升级不触碰，这里只需要确认目录还在。

VAR_DIR="${TRIM_PKGVAR:-/var/apps/douyin-local/var}"
LOG="${TRIM_TEMP_LOGFILE:-/dev/stdout}"

if [ ! -d "$VAR_DIR" ]; then
  mkdir -p "$VAR_DIR" 2>/dev/null || true
fi

echo "正在升级 douyin-local。原有数据库、收藏、观看历史与封面缓存都会保留。" >> "$LOG"

exit 0
