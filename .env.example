# 复制为 .env 后修改。docker compose 会自动读取同目录下的 .env。

# ---- 镜像 ----
# 改成你自己的仓库地址。CI 默认推送到 GHCR，格式为 ghcr.io/<GitHub用户名>/douyin-local:latest
IMAGE=ghcr.io/gaoyubao0917/douyin-local:latest

# ---- 端口 ----
PORT=6688

# ---- 视频目录（宿主机绝对路径）----
# 群晖示例：/volume1/video
# 飞牛 fnOS 示例：/vol1/1000/视频
# 绿联 / 普通 Linux：/mnt/user/videos
VIDEO_HOST_DIR=./videos

# ---- 数据目录（宿主机绝对路径）----
DATA_HOST_DIR=./data

# ---- 性能 ----
# 同时运行的 ffmpeg 任务数。低功耗 NAS 建议 1，N100 及以上建议 2。
JOB_CONCURRENCY=2
FFMPEG_THREADS=1

# auto | vaapi | off
HWACCEL=auto

# ---- 扫描 ----
SCAN_ON_START=true
# 定时增量扫描间隔（秒）。0 表示关闭，可用 3600 表示每小时一次。
RESCAN_INTERVAL=0

# 想让播放器只处理 mp4 时改成：VIDEO_EXTS=mp4,m4v,mov
VIDEO_EXTS=mp4,m4v,mov,webm,ogv,mkv,avi,flv,ts,m2ts,wmv,mpg,mpeg,3gp

# 网页上传的落盘目录，留空表示用第一个视频目录
UPLOAD_DIR=

# ---- 其它 ----
TZ=Asia/Shanghai
LOG_LEVEL=info
